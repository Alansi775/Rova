# ---- ROVA backend configuration -------------------------------------------
NODE_ENV=development
PORT=3111

# PostgreSQL
DATABASE_URL=postgres://mohammed@localhost:5432/rova

# Private device token. Generate one with:  openssl rand -hex 32
# Every /v1/* request must send:  Authorization: Bearer <token>
ROVA_DEVICE_TOKEN=

# İETT fleet service. No credentials are required today, but the published
# usage document allows a maximum of 100 requests per hour to this service.
IETT_FLEET_URL=https://api.ibb.gov.tr/iett/FiloDurum/SeferGerceklesme.asmx
IETT_NETWORK_URL=https://api.ibb.gov.tr/iett/UlasimAnaVeri/HatDurakGuzergah.asmx
IETT_HOURLY_LIMIT=40

# Lines the ingester keeps warm (comma separated İETT line codes).
INGEST_ENABLED=false
INGEST_LINES=146,142,142A,HS2

# Retention for raw position history, in hours.
POSITION_HISTORY_HOURS=72

# Set to true ONLY in development. Demo data is always labelled DEMO and is
# refused when NODE_ENV=production.
ROVA_DEMO_MODE=false
